#!/usr/bin/env bash
# brig: control plane for the Brigadier skill.
# Spawns Claude Code (and, if installed, Codex) workers in terminal tabs or windows (cmux or tmux),
# instruments them (statusline + hooks, or the codex-worker loop, write state files),
# runs plan and code reviews, and lets the brigadier block cheaply until something
# needs its attention. Every bundled script is started with `bash <path>`, so the
# skill works even when an installer drops the executable bits.
set -euo pipefail

BRIG_VERSION="0.1.0"
SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BRIG_SCRIPT="$SKILL_DIR/scripts/brig"
CFG_ROOT="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
BRIG_HOME="${BRIG_HOME:-$CFG_ROOT/brigadier}"

die() { echo "brig: $*" >&2; exit 1; }
now() { date +%s; }
# One-line control files. CR, NUL and BOM bytes are dropped, so a file written by Notepad or
# PowerShell (CRLF, UTF-16) still reads as the plain word in it.
readf() { if [[ -f "$1" ]]; then LC_ALL=C tr -d '\n\r\000\376\377' <"$1"; else echo "${2:-}"; fi; }
q() { printf '%q' "$1"; }

# ---- Windows (Git Bash, MSYS2, Cygwin) ---------------------------------------------
# A native jq.exe writes CRLF unless given -b, and every $(jq -r …) would keep the \r.
# Paths that leave bash (prompts for Claude or Codex, arguments to native programs) go out
# in mixed form, C:/Users/…, which both Git Bash and Windows programs understand.
case "$(uname -s 2>/dev/null)" in MINGW*|MSYS*|CYGWIN*) IS_WINDOWS=1 ;; *) IS_WINDOWS="" ;; esac
is_windows() { [[ -n "$IS_WINDOWS" ]]; }
native_path() { if is_windows && command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else printf '%s\n' "$1"; fi; }
posix_path() { if is_windows && command -v cygpath >/dev/null 2>&1; then cygpath -u "$1"; else printf '%s\n' "$1"; fi; }
# Git Bash's own bash.exe, as a C:/… path. On Windows a bare `bash` can be WSL's launcher
# (System32\bash.exe), so hooks, the statusLine and terminal tabs name this one in full.
# bin\bash.exe sets up PATH for MSYS; usr\bin\bash.exe ($BASH) is the fallback.
git_bash() {
  local c root=""
  if command -v cygpath >/dev/null 2>&1; then root="$(cygpath -m / 2>/dev/null)"; fi
  for c in "${CLAUDE_CODE_GIT_BASH_PATH:-}" "${root:+${root%/}/bin/bash.exe}" "$(native_path "$BASH")"; do
    if [[ -n "$c" && -f "$c" ]]; then echo "$c"; return 0; fi
  done
  return 1
}
# How a command line written for Claude Code starts bash: Git Bash in full (quoted) on Windows.
bash_cmd() {
  local b
  if is_windows && b="$(git_bash)"; then printf '"%s"\n' "$b"; else echo bash; fi
}
# Lines for launch.sh/rebirth.sh on Windows. MSYS rewrites any argument to a native program that
# starts with / (so `/brigadier resume …` reached claude.exe as `C:/Program Files/Git/brigadier …`).
# Only the slash command is excluded: the variable is inherited by the session's own Git Bash.
win_launch_lines() {
  is_windows || return 0
  echo "export PATH=$(q "$(path_with_tools)")"
  echo "export MSYS2_ARG_CONV_EXCL=$(q "${SLASH:-/brigadier}")"
}
# Where winget and the Claude Code installer put tools. A terminal opened before the install
# doesn't have them on PATH yet, so setup, doctor and new workers add them themselves.
win_tool_dirs() {
  is_windows || return 0
  local d la="${LOCALAPPDATA:-}" pf="${ProgramFiles:-}" up="${USERPROFILE:-}"
  for d in "${la:+$la/Microsoft/WinGet/Links}" "${pf:+$pf/WinGet/Links}" "${up:+$up/.local/bin}"; do
    if [[ -n "$d" && -d "$d" ]]; then posix_path "$d"; fi
  done
  if [[ -n "$la" && -d "$la/Microsoft/WinGet/Packages" ]]; then
    find "$la/Microsoft/WinGet/Packages" -maxdepth 2 -iname 'jq*.exe' 2>/dev/null | while IFS= read -r d; do posix_path "$(dirname "$d")"; done
  fi
  true
}
# PATH plus any of those dirs it lacks.
path_with_tools() {
  local p="$PATH" d
  while IFS= read -r d; do
    [[ -n "$d" && ":$p:" != *":$d:"* ]] && p="$p:$d"
  done < <(win_tool_dirs)
  printf '%s\n' "$p"
}
# On Windows, jq runs with -b. If a winget install happened after this terminal opened, jq is found
# where winget put it, under either of its names. (No wrapper without a jq: doctor must see it's missing.)
if is_windows; then
  command -v jq >/dev/null 2>&1 || PATH="$(path_with_tools)"
  if command -v jq >/dev/null 2>&1; then jq() { command jq -b "$@"; }
  else
    JQ_EXE="$(IFS=:; for _d in $PATH; do ls "$_d"/jq-*.exe 2>/dev/null; done | head -1 || true)"
    if [[ -n "$JQ_EXE" ]]; then jq() { command "$JQ_EXE" -b "$@"; }; fi
  fi
fi
# Source a shell file written by hand. One with Windows line endings is sourced from a CR-free copy.
source_file() {
  # shellcheck disable=SC1090
  if ! grep -q $'\r' "$1" 2>/dev/null; then source "$1"; return; fi
  local _t _rc=0; _t="$(mktemp "${TMPDIR:-/tmp}/brig-config.XXXXXX")" || return 1
  # shellcheck disable=SC1090
  tr -d '\r' <"$1" >"$_t" && source "$_t" || _rc=1
  rm -f "$_t"; return "$_rc"
}
# CLAUDE_CONFIG_DIR may be set the Windows way (C:\Users\…\.claude).
if is_windows; then CFG_ROOT="$(posix_path "$CFG_ROOT")"; BRIG_HOME="$(posix_path "$BRIG_HOME")"; fi
# On Windows a path may come as C:/… or C:\…; posix_path turns it into /c/… first.
abspath() { local p; p="$(posix_path "$1")"; if [[ "$p" == /* ]]; then echo "$p"; else echo "$PWD/$p"; fi; }
if stat -c %Y / >/dev/null 2>&1; then
  mtime() { if [[ -e "$1" ]]; then stat -c %Y "$1"; else echo 0; fi; }
else
  mtime() { if [[ -e "$1" ]]; then stat -f %m "$1"; else echo 0; fi; }
fi
hhmm() {
  (( $1 > 0 )) || { echo "--:--"; return; }
  date -d "@$1" +%H:%M 2>/dev/null || date -r "$1" +%H:%M 2>/dev/null || echo "--:--"
}

# The Brigadier app runs its own overnight mode; this skill stays out of its sessions.
case "${1:-help}" in
  help|-h|--help|version|--version) ;;
  *) if [[ -n "${BRIGADIER_SESSION:-}" ]]; then
       echo "Brigadier skill doesn't run inside the Brigadier app. Use the app's Overnight mode there." >&2
       exit 3
     fi ;;
esac

# ---- configuration ------------------------------------------------------------
# Precedence: environment > <run>/config.env > ~/.claude/brigadier/config.env > defaults.
BRIG_KEYS="BRIG_BACKEND BRIG_DEFAULT_MODEL BRIG_CHORE_MODEL BRIG_ALLOWED_MODELS BRIG_DEFAULT_EFFORT BRIG_MAX_EFFORT
BRIG_MAX_WORKERS BRIG_CTX_PCT BRIG_CTX_TOKENS BRIG_SELF_TOKENS BRIG_STALL_MIN BRIG_IDLE_SEC BRIG_RATE_PCT BRIG_POLL
BRIG_CODEX BRIG_CODEX_SANDBOX BRIG_REVIEWER BRIG_PERMISSION_MODE BRIG_CLAUDE_CONFIG_DIR BRIG_REBIRTH_TIMEOUT BRIG_TMUX_SOCKET BRIG_TMUX_MODE"
ENV_SET=" "
for _k in $BRIG_KEYS; do
  if [[ -n "${!_k+x}" ]]; then ENV_SET+="$_k "; eval "ENV_$_k=\${$_k}"; fi
done
USER_CONFIG="$BRIG_HOME/config.env"

effort_rank() { case "$1" in low) echo 1 ;; medium) echo 2 ;; high) echo 3 ;; xhigh) echo 4 ;; max) echo 5 ;; *) echo 0 ;; esac; }
# models_within <list> <limit>: every model in <list> is allowed by <limit> ("*" allows any).
models_within() {
  [[ "$2" == "*" ]] && return 0
  [[ "$1" == "*" ]] && return 1
  local m; for m in $1; do [[ " $2 " == *" $m "* ]] || return 1; done
}
envset() { [[ "$ENV_SET" == *" $1 "* ]]; }
# After load_config:
#   RUN_IGNORED          run-level settings dropped because they'd loosen the user's own limits
#   RUN_MODEL_DIRECTIVE  the run's config.env names the workers' model (a model directive in the goal)
#   RUN_CODEX_ON         the run's config.env says BRIG_CODEX=on (the goal names Codex for a role)
#   USER_DEFAULT_MODEL, USER_ALLOWED_MODELS  the user's own (config file or environment), for the brigadier
load_config() {
  local run="${1:-}" k v um ua
  for k in $BRIG_KEYS; do unset "$k"; done
  RUN_IGNORED=""; RUN_MODEL_DIRECTIVE=""; RUN_CODEX_ON=""
  if [[ -f "$USER_CONFIG" ]]; then source_file "$USER_CONFIG" || die "cannot read $USER_CONFIG"; fi
  # The user's limits. A run may tighten them, never loosen them.
  um="${BRIG_MAX_EFFORT:-high}"; ua="${BRIG_ALLOWED_MODELS:-*}"; USER_DEFAULT_MODEL="${BRIG_DEFAULT_MODEL:-opus}"
  if envset BRIG_MAX_EFFORT; then um="$ENV_BRIG_MAX_EFFORT"; fi
  if envset BRIG_ALLOWED_MODELS; then ua="$ENV_BRIG_ALLOWED_MODELS"; fi
  if envset BRIG_DEFAULT_MODEL; then USER_DEFAULT_MODEL="$ENV_BRIG_DEFAULT_MODEL"; fi
  USER_ALLOWED_MODELS="$ua"
  if [[ -n "$run" && -f "$run/config.env" ]]; then
    unset BRIG_MAX_EFFORT BRIG_ALLOWED_MODELS
    source_file "$run/config.env" || die "cannot read $run/config.env"
    if [[ -n "${BRIG_MAX_EFFORT:-}" ]] && ! (( $(effort_rank "$BRIG_MAX_EFFORT") > 0 && $(effort_rank "$BRIG_MAX_EFFORT") <= $(effort_rank "$um") )); then
      RUN_IGNORED+="BRIG_MAX_EFFORT "; unset BRIG_MAX_EFFORT
    fi
    if [[ -n "${BRIG_ALLOWED_MODELS:-}" ]] && ! models_within "$BRIG_ALLOWED_MODELS" "$ua"; then
      RUN_IGNORED+="BRIG_ALLOWED_MODELS "; unset BRIG_ALLOWED_MODELS
    fi
    : "${BRIG_MAX_EFFORT:=$um}" "${BRIG_ALLOWED_MODELS:=$ua}"
    if grep -Eq '^[[:space:]]*(export[[:space:]]+)?BRIG_DEFAULT_MODEL=' "$run/config.env"; then RUN_MODEL_DIRECTIVE=1; fi
    if grep -Eq '^[[:space:]]*(export[[:space:]]+)?BRIG_CODEX=["'"'"']?on' "$run/config.env"; then RUN_CODEX_ON=1; fi
  fi
  for k in $ENV_SET; do v="ENV_$k"; printf -v "$k" '%s' "${!v}"; done
  envset BRIG_DEFAULT_MODEL && RUN_MODEL_DIRECTIVE=""
  : "${BRIG_BACKEND:=auto}" "${BRIG_DEFAULT_MODEL:=opus}" "${BRIG_CHORE_MODEL:=sonnet}" "${BRIG_ALLOWED_MODELS:=*}"
  : "${BRIG_DEFAULT_EFFORT:=high}" "${BRIG_MAX_EFFORT:=high}" "${BRIG_MAX_WORKERS:=3}"
  : "${BRIG_CTX_PCT:=70}" "${BRIG_CTX_TOKENS:=300000}" "${BRIG_SELF_TOKENS:=150000}"
  : "${BRIG_STALL_MIN:=30}" "${BRIG_IDLE_SEC:=120}" "${BRIG_RATE_PCT:=95}" "${BRIG_POLL:=15}"
  : "${BRIG_CODEX:=auto}" "${BRIG_CODEX_SANDBOX:=workspace-write}" "${BRIG_REVIEWER:=auto}" "${BRIG_PERMISSION_MODE:=bypassPermissions}"
  : "${BRIG_CLAUDE_CONFIG_DIR:=}" "${BRIG_REBIRTH_TIMEOUT:=900}" "${BRIG_TMUX_SOCKET:=}" "${BRIG_TMUX_MODE:=auto}"
}
load_config

check_effort() {
  local r m; r="$(effort_rank "$1")"; m="$(effort_rank "$BRIG_MAX_EFFORT")"
  (( r > 0 )) || die "unknown effort '$1' (low, medium, high, xhigh, max)"
  (( r <= m )) || die "effort '$1' is above BRIG_MAX_EFFORT=$BRIG_MAX_EFFORT (raise it in $USER_CONFIG if you mean it)"
}
model_allowed() { models_within "$1" "${2:-$BRIG_ALLOWED_MODELS}"; }
claude_model() {
  local m="${1:-$BRIG_DEFAULT_MODEL}"
  model_allowed "$m" || die "model '$m' is not in BRIG_ALLOWED_MODELS ($BRIG_ALLOWED_MODELS); change the list in $USER_CONFIG"
  echo "$m"
}
allowed_json() {
  # shellcheck disable=SC2086
  if [[ "$BRIG_ALLOWED_MODELS" == "*" ]]; then echo null; else printf '%s\n' $BRIG_ALLOWED_MODELS | jq -R . | jq -sc .; fi
}
check_permission_mode() {
  case "$BRIG_PERMISSION_MODE" in
    bypassPermissions|acceptEdits|auto|dontAsk|manual) ;;
    *) die "BRIG_PERMISSION_MODE '$BRIG_PERMISSION_MODE' must be bypassPermissions, acceptEdits, auto, dontAsk or manual" ;;
  esac
  case "$BRIG_CODEX_SANDBOX" in
    workspace-write|bypass) ;;
    *) die "BRIG_CODEX_SANDBOX '$BRIG_CODEX_SANDBOX' must be workspace-write or bypass" ;;
  esac
}
# One line on how workers are allowed to act, for doctor (and so setup).
posture() {
  local cx="Codex sandboxed (workspace-write: the repo, its git dirs and the worker's own dir; network on)"
  [[ "$BRIG_CODEX_SANDBOX" == bypass ]] && cx="Codex unsandboxed (BRIG_CODEX_SANDBOX=bypass)"
  echo "workers and the reborn brigadier: Claude $BRIG_PERMISSION_MODE · $cx. Change with BRIG_PERMISSION_MODE and BRIG_CODEX_SANDBOX in $USER_CONFIG"
}
# Longest message `brig send` types or queues; anything longer goes through a file (send --file).
MSG_MAX=2000
codex_on() {
  case "$BRIG_CODEX" in
    off) return 1 ;;
    on) command -v codex >/dev/null 2>&1 || die "BRIG_CODEX=on but 'codex' is not on PATH" ;;
    *) command -v codex >/dev/null 2>&1 ;;
  esac
}
reviewer() {
  case "$BRIG_REVIEWER" in
    off|claude) echo "$BRIG_REVIEWER" ;;
    codex) codex_on || die "BRIG_REVIEWER=codex but Codex is unavailable (not on PATH or BRIG_CODEX=off)"; echo codex ;;
    *) if codex_on; then echo codex; else echo claude; fi ;;
  esac
}
# The platform, for install commands: macos | windows | debian | fedora | arch | alpine | suse | linux.
os_kind() {
  local id=""
  if is_windows; then echo windows; return; fi
  case "$(uname -s 2>/dev/null)" in Darwin) echo macos; return ;; esac
  local f="${BRIG_OS_RELEASE:-/etc/os-release}"
  # shellcheck disable=SC1090
  [[ -f "$f" ]] && id="$(. "$f"; echo "${ID:-} ${ID_LIKE:-}")"
  case "$id" in
    *debian*|*ubuntu*) echo debian ;;
    *fedora*|*rhel*|*centos*) echo fedora ;;
    *arch*) echo arch ;;
    *alpine*) echo alpine ;;
    *suse*) echo suse ;;
    *) echo linux ;;
  esac
}
# winget package ids for the tools Brigadier needs.
winget_id() { case "$1" in jq) echo jqlang.jq ;; git) echo Git.Git ;; claude) echo Anthropic.ClaudeCode ;; esac; }
# pkg_cmd <os> <pkg>...: the exact command that installs them, or nothing if there's no known one.
pkg_cmd() {
  local os="$1"; shift
  case "$os" in
    macos) echo "brew install $*" ;;
    debian) echo "sudo apt install -y $*" ;;
    fedora) echo "sudo dnf install -y $*" ;;
    arch) echo "sudo pacman -S --needed $*" ;;
    alpine) echo "sudo apk add $*" ;;
    suse) echo "sudo zypper install -y $*" ;;
    windows)
      local p id out=""
      for p in "$@"; do id="$(winget_id "$p")"; [[ -n "$id" ]] && out+="${out:+ && }winget install --id $id -e --source winget"; done
      echo "$out" ;;
  esac
}
install_hint() {
  local c; c="$(pkg_cmd "$(os_kind)" "$1")"
  if [[ -n "$c" ]]; then echo "Install it with: $c"; else echo "Install '$1' with your package manager"; fi
}
CLAUDE_INSTALL_HINT="https://code.claude.com/docs/en/setup"

# ---- terminal backends ----------------------------------------------------------
# Optional backend functions default to quiet no-ops.
be_notify() { :; }
be_status() { :; }
be_status_clear() { :; }
be_watch_hint() { :; }
be_finish() { :; }
be_self_id() { :; }
be_send_key() { echo "brig: the $BACKEND_LOADED backend can't press keys (it has no be_send_key)" >&2; return 1; }
BACKEND_LOADED=""
load_backend() {
  local b="$1"
  [[ "$BACKEND_LOADED" == "$b" ]] && return 0
  [[ "$b" =~ ^[a-z0-9_-]+$ && -f "$SKILL_DIR/scripts/backends/$b.sh" ]] || die "unknown terminal backend '$b' (available: $(find "$SKILL_DIR/scripts/backends" -name '*.sh' -exec basename {} .sh \; | sort | tr '\n' ' '))"
  # shellcheck disable=SC1090
  source "$SKILL_DIR/scripts/backends/$b.sh"
  BACKEND_LOADED="$b"
}
# Which backend a NEW run uses. An existing run always uses the one recorded in its run.env.
pick_backend() {
  case "$BRIG_BACKEND" in
    auto)
      if [[ -n "${CMUX_WORKSPACE_ID:-}" ]] && command -v cmux >/dev/null 2>&1; then echo cmux
      elif [[ "$(wmux_flavor)" == amirlehmam ]] && command -v wmux >/dev/null 2>&1; then echo wmux
      elif [[ "$(wmux_flavor)" == openwong2kim ]] && command -v powershell.exe >/dev/null 2>&1; then echo wmux-ow
      elif command -v tmux >/dev/null 2>&1; then echo tmux
      else return 1; fi ;;
    *) echo "$BRIG_BACKEND" ;;
  esac
}
# Two unrelated Windows apps are called wmux, and both are supported:
#   amirlehmam/wmux   (backend wmux, recommended)  sets WMUX=1, WMUX_SURFACE_ID, WMUX_CLI, WMUX_PIPE
#   openwong2kim/wmux (backend wmux-ow, fallback)   sets WMUX_PTY_ID, WMUX_WORKSPACE_ID, TERM_PROGRAM=wmux
# openwong2kim may set WMUX_SURFACE_ID too, so amirlehmam is recognised by its own variables.
# If both look present, amirlehmam wins.
wmux_flavor() {
  if [[ -n "${WMUX_SURFACE_ID:-}" && ( "${WMUX:-}" == 1 || -n "${WMUX_CLI:-}${WMUX_PIPE:-}" ) ]]; then echo amirlehmam
  elif [[ -n "${WMUX_PTY_ID:-}" || "${TERM_PROGRAM:-}" == wmux ]]; then echo openwong2kim
  fi
}
WMUX_RELEASES="https://github.com/amirlehmam/wmux/releases/latest"
WMUX_TESTED="2.24.0"
WMUX_OW_TESTED="4.5.0"
WMUX_OW_WINGET="winget install --id openwong2kim.wmux -e --source winget"
no_terminal_msg() {
  if ! is_windows; then
    echo "Brigadier needs cmux or tmux to run workers, and neither is available. $(install_hint tmux) — then run /brigadier again from any terminal; it starts tmux in the background for you."
    return
  fi
  case "$(wmux_flavor)" in
    amirlehmam) echo "This is a wmux tab, but the 'wmux' command isn't on PATH. Close this tab, open a new one in wmux and start Claude Code there." ;;
    openwong2kim) printf '%s\n' "This is an openwong2kim/wmux tab, but powershell.exe isn't on PATH (Brigadier talks to this wmux through it). Add C:\\Windows\\System32\\WindowsPowerShell\\v1.0 to PATH, or use amirlehmam/wmux: $(wmux_install_steps)" ;;
    *) echo "On Windows, Brigadier runs its workers in wmux (tabs, like cmux on macOS), and this isn't a wmux tab. $(wmux_install_steps)" ;;
  esac
}
wmux_install_steps() {
  echo "Recommended: amirlehmam/wmux. Download wmux-<version>-setup.exe from $WMUX_RELEASES (tested with $WMUX_TESTED) and run it. Alternative: openwong2kim/wmux, with: $WMUX_OW_WINGET. Then open wmux, start Claude Code in a wmux tab, and run /brigadier setup there."
}
# One line on the wmux in use, for doctor: which project, its version, and what it can't do.
wmux_doctor_line() {
  local v
  case "$1" in
    wmux)
      v="$(wmux identify 2>/dev/null | jq -r '.version // empty' 2>/dev/null || true)"
      echo "terminal: wmux (amirlehmam/wmux ${v:-version unknown}, tab $WMUX_SURFACE_ID; tested with $WMUX_TESTED)" ;;
    wmux-ow)
      load_backend wmux-ow
      v="$(ow_rpc system.identify '{}' 2>/dev/null | jq -r '.version // empty' 2>/dev/null || true)"
      echo "terminal: wmux-ow (openwong2kim/wmux ${v:-version unknown: its pipe did not answer}, pane $WMUX_PTY_ID; tested with $WMUX_OW_TESTED). The fallback: tabs keep wmux's own titles, the sidebar status may not clear, and only tabs in this workspace are tracked" ;;
  esac
}

# ---- runs -----------------------------------------------------------------------
# Every brigadier is bound to its run through its own identity, never through a shared pointer:
#   1. BRIG_RUN (run id or path)        - init prints it; the skill passes it on every call
#   2. BRIG_WORKER_DIR                  - a worker's own run (set by its launch script)
#   3. a binding for this session       - cmux surface, tmux pane, or Claude session id
#   4. the only unfinished run          - refused when several runs are unfinished
identity() {
  if [[ -n "${CMUX_SURFACE_ID:-}" ]]; then echo "cmux-$CMUX_SURFACE_ID"
  elif [[ -n "${WMUX_SURFACE_ID:-}" ]]; then echo "wmux-$WMUX_SURFACE_ID"
  elif [[ -n "${WMUX_PTY_ID:-}" ]]; then echo "wmuxow-$WMUX_PTY_ID"
  elif [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]]; then echo "tmux-$(cut -d, -f2 <<<"$TMUX")-${TMUX_PANE#%}"
  elif [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]]; then echo "claude-$CLAUDE_CODE_SESSION_ID"
  fi
}
# A binding is a one-line file holding the run dir. (Symlinks from older versions are still read;
# Git Bash's `ln -s` copies instead of linking, so new bindings never use one.)
bind_identity() {
  local id p; id="$(identity)"; [[ -n "$id" && -z "${BRIG_WORKER:-}" ]] || return 0
  p="$BRIG_HOME/bindings/$id"
  mkdir -p "$BRIG_HOME/bindings" || return 0
  if [[ -L "$p" ]]; then rm -f "$p"; elif [[ -d "$p" ]]; then rm -rf "$p"; fi
  printf '%s\n' "$1" >"$p"
}
unfinished_runs() {
  local e; [[ -d "$BRIG_HOME/runs" ]] || return 0
  for e in "$BRIG_HOME"/runs/*; do [[ -f "$e/run.env" && ! -f "$e/finished" ]] && basename "$e"; done; true
}
run_dir() {
  local r="${BRIG_RUN:-}" id p
  if [[ -z "$r" && -n "${BRIG_WORKER_DIR:-}" ]]; then r="$(dirname "$(dirname "$BRIG_WORKER_DIR")")"; fi
  if [[ -z "$r" ]]; then
    id="$(identity)"; p="$BRIG_HOME/bindings/$id"
    if [[ -n "$id" && -L "$p" ]]; then r="$(readlink "$p")"
    elif [[ -n "$id" && -f "$p" ]]; then r="$(readf "$p")"; fi
  fi
  if [[ -z "$r" ]]; then
    local list n; list="$(unfinished_runs)"; n="$(grep -c . <<<"$list" || true)"
    case "$n" in
      0) die "no active run; start one with 'brig init <slug>' or pick one with 'brig use <run-id>'" ;;
      1) r="$list"; bind_identity "$BRIG_HOME/runs/$r" ;;
      *) die "several runs are active ($(tr '\n' ' ' <<<"$list")); pass BRIG_RUN=<run-id> or run 'brig use <run-id>'" ;;
    esac
  fi
  [[ "$r" == /* ]] || r="$BRIG_HOME/runs/$r"
  [[ -d "$r" && -f "$r/run.env" ]] || die "run not found: $r"
  echo "$r"
}
# Load a run: its run.env, its config, its backend. Sets RUN.
open_run() {
  RUN="$(run_dir)"
  # shellcheck disable=SC1091
  source "$RUN/run.env"
  load_config "$RUN"
  load_backend "$BACKEND"
}

wdir() {
  local d; d="$RUN/workers/$1"
  [[ "$1" =~ ^[A-Za-z0-9_-]+$ && -d "$d" ]] || die "unknown worker: $1"
  echo "$d"
}
workers() { if [[ -d "$RUN/workers" ]]; then find "$RUN/workers" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort; fi; }
live_workers() { local w; for w in $(workers); do [[ "$(readf "$RUN/workers/$w/.state")" == live ]] && echo "$w"; done; true; }
agent_of() { readf "$1/agent" claude; }
log_event() { echo "$(date '+%H:%M') $*" >>"$RUN/events.log"; }

sl() { if [[ -f "$1/statusline.json" ]]; then jq -r "$2" "$1/statusline.json" 2>/dev/null || echo 0; else echo 0; fi; }
ctx_pct() { sl "$1" '(.context_window.used_percentage // 0) | floor'; }
ctx_tokens() { sl "$1" '((.context_window.used_percentage // 0) * (.context_window.context_window_size // 0) / 100) | floor'; }
rate_pct() { sl "$1" '(.rate_limits.five_hour.used_percentage // 0) | floor'; }
rate_reset() { sl "$1" '.rate_limits.five_hour.resets_at // 0'; }
ctx_label() { if [[ "$(agent_of "$1")" == codex ]]; then echo "-"; else echo "$(ctx_pct "$1")%"; fi; }
busy() { (( $(mtime "$1/prompt.ts") > $(mtime "$1/stop.json") )); }
# What a Claude worker's screen says it is doing: trust | interrupted | working | background | idle | unknown.
# A turn cut off by Esc or a restart fires no Stop hook, so `busy` stays true; only the screen shows it.
screen_state() {
  local txt; txt="$(be_read "$(readf "$1/surface")" 30 2>/dev/null)" || { echo unknown; return; }
  if [[ ! -f "$1/session.json" ]] && is_trust_screen "$txt"; then echo trust; return; fi
  txt="$(tail -n 14 <<<"$txt")"
  if grep -q "Interrupted ·" <<<"$txt"; then echo interrupted
  elif grep -q "…" <<<"$txt"; then echo working
  elif grep -Eq "shells? still running|· [0-9]+ shells? ·" <<<"$txt"; then echo background
  else echo idle; fi
}
transcript_mtime() {
  local tp="" tm
  [[ -f "$1/session.json" ]] && tp="$(jq -r '.transcript_path // ""' "$1/session.json" 2>/dev/null || true)"
  tm="$(mtime "${tp:-/nonexistent}")"; (( tm == 0 )) && tm="$(mtime "$1/prompt.ts")"; echo "$tm"
}
# The calling Claude session's own context in tokens (last assistant turn's input), 0 if unknown.
self_tokens() {
  local id="${CLAUDE_CODE_SESSION_ID:-}" f
  [[ -n "$id" ]] || { echo 0; return; }
  f="$(find "$CFG_ROOT/projects" -maxdepth 2 -name "$id.jsonl" 2>/dev/null | head -1)"
  [[ -n "$f" ]] || { echo 0; return; }
  tail -200 "$f" | jq -r 'select(.type=="assistant") | .message.usage // empty
    | (.input_tokens // 0) + (.cache_creation_input_tokens // 0) + (.cache_read_input_tokens // 0)' 2>/dev/null | tail -1 | grep . || echo 0
}
# Environment a fresh Claude/Codex session must not inherit from the brigadier's own session.
clean_env_lines() {
  echo 'unset CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SESSION_ID CLAUDE_CODE_SSE_PORT BRIG_WORKER BRIG_WORKER_DIR'
  if [[ -n "$BRIG_CLAUDE_CONFIG_DIR" ]]; then echo "export CLAUDE_CONFIG_DIR=$(q "$BRIG_CLAUDE_CONFIG_DIR")"; fi
}
claude_settings_json() {
  local hook="$1" d="$2" skip=false
  [[ "$BRIG_PERMISSION_MODE" == bypassPermissions ]] && skip=true
  jq -n --arg h "$hook" --arg d "$(q "$d")" --argjson allowed "$(allowed_json)" --arg eff "$BRIG_DEFAULT_EFFORT" --argjson skip "$skip" '{
    effortLevel: $eff,
    skipDangerousModePermissionPrompt: $skip,
    statusLine: {type: "command", command: "\($h) statusline \($d)"},
    hooks: {
      SessionStart:     [{hooks: [{type: "command", command: "\($h) session \($d)"}]}],
      UserPromptSubmit: [{hooks: [{type: "command", command: "\($h) prompt \($d)"}]}],
      Stop:             [{hooks: [{type: "command", command: "\($h) stop \($d)"}]}],
      Notification:     [{hooks: [{type: "command", command: "\($h) notify \($d)"}]}],
      PreCompact:       [{hooks: [{type: "command", command: "\($h) precompact \($d)"}]}]
    }} + (if $allowed == null then {} else {availableModels: $allowed} end)'
}

# ---- Claude Code's folder trust ----------------------------------------------------
# A Claude session in a folder it doesn't trust waits at a "trust this folder" dialog, before any
# hook runs. brig only reads Claude Code's list (it owns .claude.json and may be writing to it).
# Measured on Claude Code 2.1.300: the key is the folder's real path (C:/… on Windows); a folder is
# trusted if it, or a parent up to its git root (up to / outside git), is, or the main checkout of
# its repo is (so worktrees count). A git repo nested in a trusted folder is not trusted.
claude_json() {
  local c="${BRIG_CLAUDE_CONFIG_DIR:-${CLAUDE_CONFIG_DIR:-}}"
  if [[ -n "$c" ]]; then echo "$(posix_path "$c")/.claude.json"; else echo "$HOME/.claude.json"; fi
}
trust_keys() {
  local d top="/" common
  d="$(cd "$1" 2>/dev/null && pwd -P)" || return 1
  if top="$(cd "$d" && git rev-parse --show-toplevel 2>/dev/null)" && [[ -n "$top" ]]; then
    top="$(cd "$top" && pwd -P)"
    if common="$(cd "$d" && cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P)" && [[ "$common" == */.git ]]; then
      native_path "${common%/.git}"
    fi
  else top=/; fi
  while :; do
    # Git Bash's / is Git's own install dir, not a folder anyone trusts.
    if [[ "$d" == / ]] && is_windows; then break; fi
    native_path "$d"
    [[ "$d" == "$top" || "$d" == / ]] && break
    d="$(dirname "$d")"
  done
}
# claude_trusted <dir>: 0 trusted, 1 not trusted, 2 can't tell (no readable .claude.json).
claude_trusted() {
  local f keys r ci=false; f="$(claude_json)"
  [[ -r "$f" ]] || return 2
  is_windows && ci=true
  keys="$(trust_keys "$1" | jq -R . | jq -sc .)" || return 2
  r="$(jq -r --argjson want "$keys" --argjson ci "$ci" '
    def n: gsub("\\\\"; "/") | if $ci then ascii_downcase else . end;
    ($want | map(n)) as $w
    | [(.projects // {}) | to_entries[] | select(.value.hasTrustDialogAccepted == true) | .key | n]
    | any(.[]; . as $p | any($w[]; . == $p))' "$f" 2>/dev/null)" || return 2
  [[ "$r" == true ]] && return 0
  return 1
}
# The dialog itself, as Claude Code 2.1.300 draws it: "Accessing workspace:", the folder, "Quick safety
# check: Is this a project you created or one you trust?", then the options "No, exit" (listed first,
# with the cursor) and "Yes, I trust this folder".
TRUST_YES="Yes, I trust this folder"
is_trust_screen() { grep -qF "$TRUST_YES" <<<"$1" || grep -qF "Is this a project you created or one you trust" <<<"$1"; }
trust_dir_of() { awk '/Accessing workspace:/ { f = 1; next } f && NF { sub(/^[ \t]+/, ""); sub(/[ \t]+$/, ""); print; exit }' <<<"$1"; }
trust_options_of() {
  grep -E "No, exit|$TRUST_YES|No, continue without" <<<"$1" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | paste -sd'|' - | sed 's/|/ | /g'
}

# ---- hooks (invoked by a Claude worker via --settings) -----------------------------
cmd__hook() {
  local kind="$1" d="$2"
  [[ -d "$d" ]] || exit 0
  case "$kind" in
    statusline)
      local j; j="$(cat)"; printf '%s' "$j" >"$d/statusline.json.tmp" && mv -f "$d/statusline.json.tmp" "$d/statusline.json"
      printf '%s' "$j" | jq -r --arg w "$(basename "$d")" '"\($w) · \(.model.display_name // "?") · ctx \((.context_window.used_percentage // 0) | floor)% · 5h \((.rate_limits.five_hour.used_percentage // 0) | floor)%"' ;;
    session) cat >"$d/session.json" ;;
    prompt) cat >/dev/null; now >"$d/prompt.ts" ;;
    stop) cat >"$d/stop.json.tmp" && mv -f "$d/stop.json.tmp" "$d/stop.json" ;;
    notify) jq -c . >>"$d/notify.jsonl" ;;
    precompact) cat >"$d/precompact.json" ;;
    *) die "unknown hook $kind" ;;
  esac
}

# ---- run lifecycle ------------------------------------------------------------------
# brig init <slug> [--slash "/brigadier"]
cmd_init() {
  local slug="" slash="/brigadier"
  while (( $# )); do
    case "$1" in
      --slash) slash="$2"; shift 2 ;;
      -*) die "init: unknown flag $1" ;;
      *) slug="$1"; shift ;;
    esac
  done
  [[ "$slug" =~ ^[a-z0-9][a-z0-9-]{0,39}$ ]] || die "usage: brig init <slug> (lowercase letters, digits and dashes)"
  [[ "$slash" =~ ^/[A-Za-z0-9:_-]+$ ]] || die "init: --slash must look like /brigadier or /brigadier-skill:brigadier"
  [[ -z "${BRIG_WORKER:-}" ]] || die "workers don't start runs"
  local b; b="$(pick_backend)" || die "$(no_terminal_msg)"
  load_backend "$b"
  local id base n=1; base="$(date +%Y%m%d-%H%M)-$slug"; id="$base"
  while [[ -e "$BRIG_HOME/runs/$id" ]]; do n=$((n + 1)); id="$base-$n"; done
  RUN="$BRIG_HOME/runs/$id"
  REPO="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  mkdir -p "$RUN/workers" "$RUN/msgs"
  {
    printf 'RUN_ID=%q\n' "$id"
    printf 'REPO=%q\n' "$REPO"
    printf 'BACKEND=%q\n' "$b"
    printf 'SLASH=%q\n' "$slash"
    printf 'CREATED=%q\n' "$(date '+%Y-%m-%d %H:%M')"
  } >"$RUN/run.env"
  local extra; extra="$(be_init_run "$RUN" "$slug")" || { rm -rf "$RUN"; exit 1; }
  printf '%s\n' "$extra" >>"$RUN/run.env"
  # shellcheck disable=SC1091
  source "$RUN/run.env"
  bind_identity "$RUN"
  log_event "init $id backend=$b mode=${MODE:-?}"
  echo "$RUN"
  echo "BRIG_RUN=$id"
  echo "backend: $b ($MODE)"
  be_watch_hint
}

# Bind this session to a run (resume, or a second tab).
cmd_use() {
  local id="${1:?usage: brig use <run-id>}"
  [[ "$id" =~ ^[A-Za-z0-9._-]+$ && -f "$BRIG_HOME/runs/$id/run.env" ]] || die "no such run: $id"
  bind_identity "$BRIG_HOME/runs/$id"
  echo "$BRIG_HOME/runs/$id"
}
cmd_run() { run_dir; }
# One run, as fields: id, state, started, finished (or ""), last event, repo, first line of the goal.
run_fields() {
  local e="$1" d="$BRIG_HOME/runs/$1" st=active fin="" last="" repo created goal
  [[ -f "$d/finished" ]] && { st=finished; fin="$(readf "$d/finished")"; }
  # run.env is shell (printf %q); read it in a bash of its own.
  # shellcheck disable=SC2016
  IFS=$'\037' read -r repo created <<<"$(bash -c 'source "$1" >/dev/null 2>&1; printf "%s\037%s\n" "${REPO:-}" "${CREATED:-}"' _ "$d/run.env")"
  [[ -f "$d/events.log" ]] && last="$(ymdhm "$(mtime "$d/events.log")")"
  if [[ -f "$d/goal.md" ]]; then
    goal="$(grep -m1 -v '^[[:space:]]*$' "$d/goal.md" | tr -d '\r' | sed -E 's/^#+[[:space:]]*//' | cut -c1-70)"
  else goal="(no goal.md)"; fi
  printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\n' "$e" "$st" "${created:--}" "$fin" "${last:--}" "$repo" "$goal"
}
ymdhm() {
  (( $1 > 0 )) || { echo "-"; return; }
  date -d "@$1" '+%Y-%m-%d %H:%M' 2>/dev/null || date -r "$1" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "-"
}
this_repo() { git rev-parse --show-toplevel 2>/dev/null || pwd; }
# brig runs [--here]: newest first. --here: only runs of the repo you're in.
# brig runs --overlap: other runs on this run's repo that were active at some point during it, judged
# by full start and finish times (an unfinished run counts as active until now).
cmd_runs() {
  local mode="${1:-}" e f here=""
  [[ -d "$BRIG_HOME/runs" ]] || return 0
  case "$mode" in
    "") ;;
    --here) here="$(this_repo)" ;;
    --overlap) cmd_overlap; return ;;
    *) die "usage: brig runs [--here | --overlap]" ;;
  esac
  printf '%-34s %-9s %-17s %-17s %s · %s\n' RUN STATE STARTED LAST REPO GOAL
  # shellcheck disable=SC2012 # run ids are [A-Za-z0-9-] by construction; ls -t gives newest first
  for e in $(ls -1t "$BRIG_HOME/runs" | head -30); do
    [[ -f "$BRIG_HOME/runs/$e/run.env" ]] || continue
    IFS=$'\037' read -r -a f <<<"$(run_fields "$e")"
    [[ -z "$here" || "${f[5]}" == "$here" ]] || continue
    printf '%-34s %-9s %-17s %-17s %s · %s\n' "${f[0]}" "${f[1]}" "${f[2]}" "${f[4]}" "${f[5]}" "${f[6]:-}"
  done
}
cmd_overlap() {
  local me mf e f now start end ostart oend n=0
  RUN="$(run_dir)"; me="$(basename "$RUN")"; now="$(date '+%Y-%m-%d %H:%M')"
  IFS=$'\037' read -r -a mf <<<"$(run_fields "$me")"
  start="${mf[2]}"; end="${mf[3]:-$now}"
  for e in "$BRIG_HOME"/runs/*; do
    e="$(basename "$e")"
    [[ "$e" != "$me" && -f "$BRIG_HOME/runs/$e/run.env" ]] || continue
    IFS=$'\037' read -r -a f <<<"$(run_fields "$e")"
    [[ "${f[5]}" == "${mf[5]}" && "${f[2]}" != - ]] || continue
    ostart="${f[2]}"; oend="${f[3]:-$now}"
    # "YYYY-MM-DD HH:MM" compares as text.
    if [[ ! "$ostart" > "$end" && ! "$start" > "$oend" ]]; then
      echo "overlap: ${f[0]} (${f[1]}, $ostart to ${f[3]:-now}) · ${f[6]:-}"; n=$((n + 1))
    fi
  done
  (( n > 0 )) || echo "no other run on ${mf[5]} was active during $me ($start to ${mf[3]:-now})"
}

render_protocol() {
  local wid="$1" d="$2" others="$3" slug="$4" t allowed
  t="$(cat "$SKILL_DIR/worker-protocol.md")"
  if [[ "$BRIG_ALLOWED_MODELS" == "*" ]]; then allowed="any model your Claude Code offers"; else allowed="only these models: $BRIG_ALLOWED_MODELS"; fi
  t="${t//"{{WID}}"/$wid}"
  t="${t//"{{DIR}}"/$(native_path "$d")}"
  t="${t//"{{REPO}}"/$(native_path "$REPO")}"
  t="${t//"{{OTHERS}}"/$others}"
  t="${t//"{{RUN_SLUG}}"/$slug}"
  t="${t//"{{ALLOWED_MODELS}}"/$allowed}"
  t="${t//"{{DEFAULT_MODEL}}"/$BRIG_DEFAULT_MODEL}"
  t="${t//"{{CHORE_MODEL}}"/$BRIG_CHORE_MODEL}"
  t="${t//"{{MAX_EFFORT}}"/$BRIG_MAX_EFFORT}"
  printf '%s\n' "$t"
}

# brig spawn <wid> <task-file> [--agent claude|codex] [--title T] [--model M] [--effort E] [--continues WID]...
cmd_spawn() {
  local wid="${1:?usage: brig spawn <wid> <task-file> [flags]}" taskf="${2:?task file}"; shift 2
  open_run
  local agent=claude title="" model="" effort="$BRIG_DEFAULT_EFFORT" prev=()
  while (( $# )); do
    case "$1" in
      --agent) agent="$2"; shift 2 ;;
      --title) title="$2"; shift 2 ;;
      --model) model="$2"; shift 2 ;;
      --effort) effort="$2"; shift 2 ;;
      --continues) prev+=("$2"); shift 2 ;;
      *) die "spawn: unknown flag $1" ;;
    esac
  done
  [[ "$wid" =~ ^[A-Za-z0-9_-]+$ ]] || die "worker id must be letters, digits, '-' or '_' (e.g. w01)"
  [[ -f "$taskf" ]] || die "task file not found: $taskf"
  check_effort "$effort"
  check_permission_mode
  case "$agent" in
    claude) model="$(claude_model "$model")" ;;
    codex) [[ -z "$RUN_MODEL_DIRECTIVE" || -n "$RUN_CODEX_ON" ]] \
             || die "this run's goal names the workers' model ($RUN/config.env sets BRIG_DEFAULT_MODEL=$BRIG_DEFAULT_MODEL), so no Codex workers: spawn a Claude worker. If the goal names Codex for a role, put BRIG_CODEX=on in $RUN/config.env"
           codex_on || die "Codex workers need the 'codex' CLI on PATH (and BRIG_CODEX not 'off')"
           [[ "$model" != *claude* ]] || die "codex model '$model' makes no sense" ;;
    *) die "agent must be claude or codex" ;;
  esac
  local d="$RUN/workers/$wid"
  [[ -e "$d" ]] && die "worker $wid already exists (never reuse a worker id)"
  # Successors don't count against the cap while their predecessors are still open.
  local live=0 w p skip
  for w in $(live_workers); do
    skip=""; for p in ${prev[@]+"${prev[@]}"}; do [[ "$p" == "$w" ]] && skip=1; done
    [[ -n "$skip" ]] || live=$((live + 1))
  done
  (( live < BRIG_MAX_WORKERS )) || die "already $live live workers (BRIG_MAX_WORKERS=$BRIG_MAX_WORKERS); close one first"
  mkdir -p "$d"
  if [[ -f "$RUN/finished" ]]; then rm -f "$RUN/finished"; log_event "reopened"; fi

  local others slug; others="$(live_workers | tr '\n' ' ')"; slug="${RUN_ID#*-*-}"
  {
    render_protocol "$wid" "$d" "${others:-none}" "$slug"
    if (( ${#prev[@]} )); then
      echo; echo "## You are continuing someone else's work"; echo
      echo "Earlier workers ran out of context on this same task. Read their handoffs in order, newest last. The newest one is authoritative:"; echo
      for p in "${prev[@]}"; do echo "- $(native_path "$RUN/workers/$p/handoff.md")"; done
      echo; echo "Before touching anything, check the real state with \`git log --oneline -15\` and \`git status\`. Don't redo finished steps and don't repeat any approval step the handoff says already happened. Your own status, report and handoff files live in YOUR private directory above, not in a predecessor's."
    fi
    echo; echo "## Your task"; echo
    cat "$taskf"
  } >"$d/task.md"
  echo "$agent" >"$d/agent"
  # Codex workers accept queued messages only with this token, which only brig writes.
  if [[ "$agent" == codex ]]; then
    (umask 077; od -An -tx1 -N16 /dev/urandom | tr -d ' \n' >"$d/.inbox_token")
    [[ -s "$d/.inbox_token" ]] || die "could not create the inbox token for $wid"
  fi
  local kickoff; kickoff="Read $(native_path "$d/task.md") and follow it exactly. It holds your whole task and the protocol for this session."

  {
    echo '#!/usr/bin/env bash'
    echo "# Worker $wid of run $RUN_ID (written by brig spawn)."
    echo "cd $(q "$REPO") || exit 1"
    clean_env_lines
    # A terminal app on Windows starts its tabs with its own environment, not the brigadier's.
    win_launch_lines
    echo "export BRIG_WORKER=$(q "$wid") BRIG_WORKER_DIR=$(q "$d") BRIG_RUN=$(q "$RUN") BRIG_SKILL_DIR=$(q "$SKILL_DIR")"
    if [[ "$agent" == claude ]]; then
      claude_settings_json "$(bash_cmd) $(q "$BRIG_SCRIPT") _hook" "$d" >"$d/settings.json"
      printf 'exec claude --permission-mode %s --disallowedTools AskUserQuestion EnterPlanMode ExitPlanMode' "$(q "$BRIG_PERMISSION_MODE")"
      printf ' --settings %s --name %s --model %s --effort %s' "$(q "$(native_path "$d/settings.json")")" "$(q "$wid${title:+ · $title}")" "$(q "$model")" "$(q "$effort")"
      printf ' %s\n' "$(q "$kickoff")"
    else
      echo "exec $(bash_cmd) $(q "$SKILL_DIR/scripts/codex-worker") $(q "$d") $(q "$REPO") $(q "$effort") $(q "$kickoff") $(q "$model") $(q "$BRIG_CODEX_SANDBOX")"
    fi
  } >"$d/launch.sh"
  chmod +x "$d/launch.sh"
  echo "$agent${model:+ $model} effort=$effort" >"$d/model"
  echo "$title" >"$d/title"

  now >"$d/prompt.ts"
  echo live >"$d/.state"
  local sid
  sid="$(be_spawn "$REPO" "$d/launch.sh" "⚙ $wid${title:+ · $title}")" || { echo closed >"$d/.state"; die "could not open a terminal for $wid"; }
  echo "$sid" >"$d/surface"
  log_event "spawn $wid [$(cat "$d/model")] ${title:+($title) }${prev[*]:+continues ${prev[*]}}"
  echo "spawned $wid [$(cat "$d/model")] surface=$sid dir=$d"
  if [[ "$agent" == claude ]]; then
    local tr=0; claude_trusted "$REPO" || tr=$?
    case "$tr" in
      1) echo "note: Claude Code hasn't trusted $(native_path "$REPO") yet (no hasTrustDialogAccepted for it in $(claude_json)), so $wid will stop at its 'trust this folder' dialog; brig wait reports it as TRUST_PROMPT" ;;
      2) echo "note: can't read Claude Code's list of trusted folders ($(claude_json)); if $wid stops at a 'trust this folder' dialog, brig wait reports it as TRUST_PROMPT" ;;
    esac
  fi
  be_watch_hint
}

# brig send <wid> <text...>      a short line, typed into Claude or queued for Codex
# brig send <wid> --file <path>  anything longer: the worker is told to read the file
cmd_send() {
  local wid="${1:?usage: brig send <wid> <text> | brig send <wid> --file <path>}"; shift
  open_run
  local d; d="$(wdir "$wid")"
  local msg
  if [[ "${1:-}" == --file ]]; then
    local f; f="$(abspath "${2:?usage: brig send <wid> --file <path>}")"
    [[ -f "$f" ]] || die "no such file: $2"
    msg="Read $(native_path "$f") and proceed. It is the brigadier's message to you."
  else
    msg="$*"; msg="${msg//$'\n'/ }"
  fi
  [[ -n "$msg" ]] || die "empty message"
  (( ${#msg} <= MSG_MAX )) || die "message is ${#msg} characters (limit $MSG_MAX). Write it to a file under $RUN/msgs/ and send it with: brig send $wid --file <path>"
  rm -f "$d/.stall_flag"
  if [[ "$(agent_of "$d")" == codex ]]; then
    # The codex-worker loop picks this up as soon as the current turn finishes. The first line
    # carries the worker's inbox token: codex-worker refuses files that lack it.
    local n; n=$(( $(readf "$d/inbox.seq" 0) + 1 )); echo "$n" >"$d/inbox.seq"
    mkdir -p "$d/inbox"
    # A worker spawned by an older brig has no token yet; codex-worker reads it per message.
    [[ -s "$d/.inbox_token" ]] || (umask 077; od -An -tx1 -N16 /dev/urandom | tr -d ' \n' >"$d/.inbox_token")
    printf 'brig-token: %s\n%s\n' "$(readf "$d/.inbox_token")" "$msg" >"$d/inbox/.$n.tmp" \
      && mv -f "$d/inbox/.$n.tmp" "$d/inbox/$(printf '%08d' "$n").msg"
  else
    local sid; sid="$(readf "$d/surface")"
    now >"$d/prompt.ts"
    be_send_text "$sid" "$msg"
    sleep 0.4
    be_send_enter "$sid"
  fi
  log_event "send $wid: ${msg:0:160}"
  echo "sent to $wid"
}

cmd_handoff() {
  local wid="${1:?usage: brig handoff <wid>}"
  cmd_send "$wid" "BRIGADIER: HANDOFF. Your context is filling up. Follow the Handoff section of your protocol now: finish only the atomic step in progress, get the tree coherent, write handoff.md, write 'handoff' to your status file, then end your turn."
}

# The rebirth successor can be inspected or closed by the name "successor".
target_surface() {
  if [[ "$1" == successor ]]; then readf "$RUN/rebirth.surface"; else readf "$(wdir "$1")/surface"; fi
}

# brig key <wid|successor> <key>...: press keys in a worker's terminal, in order (answering a dialog).
KEYS_ALLOWED="enter escape up down left right tab space 1 2 3 4 5 6 7 8 9"
cmd_key() {
  local wid="${1:?usage: brig key <wid> <key>... (keys: ${KEYS_ALLOWED// /, })}"; shift
  (( $# )) || die "usage: brig key <wid> <key>... (keys: ${KEYS_ALLOWED// /, })"
  open_run
  local sid a k keys=() n=0; sid="$(target_surface "$wid")"; [[ -n "$sid" ]] || die "$wid has no terminal"
  # Every key is checked before the first one is pressed.
  for a in "$@"; do
    k="$(tr '[:upper:]' '[:lower:]' <<<"$a")"
    case "$k" in esc) k=escape ;; return) k=enter ;; esac
    [[ " $KEYS_ALLOWED " == *" $k "* ]] || die "key '$a' is not one brig presses (keys: ${KEYS_ALLOWED// /, }); nothing was pressed"
    keys+=("$k")
  done
  for k in "${keys[@]}"; do
    (( n++ )) && sleep 0.3
    be_send_key "$sid" "$k" || die "the terminal refused '$k' for $wid (its message is above); $(( n - 1 )) of ${#keys[@]} keys were pressed"
  done
  log_event "key $wid: ${keys[*]}"
  echo "pressed in $wid: ${keys[*]}"
}

# brig trust <wid>: accept Claude Code's "trust this folder" dialog. The option with the cursor is read
# off the screen first; if the dialog can't be read for sure, nothing is pressed.
cmd_trust() {
  local wid="${1:?usage: brig trust <wid>}"
  open_run
  local d sid txt yes cur n i moves keys=() opts; d="$(wdir "$wid")"; sid="$(readf "$d/surface")"
  [[ "$(agent_of "$d")" == claude ]] || die "$wid is a Codex worker; only Claude Code has a trust dialog"
  # Its SessionStart hook has run, so the folder is trusted already: there's nothing to answer.
  [[ ! -f "$d/session.json" ]] || die "TRUST_UNREADABLE: $wid's screen doesn't show Claude Code's trust dialog (its session has started); nothing was pressed"
  txt="$(be_read "$sid" 30)" || die "can't read $wid's screen"
  opts="$(trust_options_of "$txt")"
  is_trust_screen "$txt" || die "TRUST_UNREADABLE: $wid's screen doesn't show Claude Code's trust dialog; nothing was pressed (brig screen $wid)"
  yes="$(grep -nF "$TRUST_YES" <<<"$txt" | tail -1 | cut -d: -f1)"
  # The cursor (❯) must sit on exactly one row of the option block around "Yes, I trust this folder".
  cur=""; n=0
  if [[ -n "$yes" ]]; then
    for (( i = yes - 4; i <= yes + 4; i++ )); do
      (( i >= 1 )) || continue
      if sed -n "${i}p" <<<"$txt" | grep -q '❯'; then cur="$i"; n=$((n + 1)); fi
    done
  fi
  if [[ -z "$yes" || "$n" -ne 1 ]]; then
    log_event "trust $wid: dialog not readable [$opts]; nothing pressed"
    die "TRUST_UNREADABLE: can't tell which option of $wid's trust dialog has the cursor (options: ${opts:-none found}); nothing was pressed. Only the user can answer it now (brig screen $wid)"
  fi
  local lo=$(( cur < yes ? cur : yes )) hi=$(( cur < yes ? yes : cur ))
  for (( i = lo; i <= hi; i++ )); do
    [[ -n "$(sed -n "${i}p" <<<"$txt" | tr -d '[:space:]')" ]] \
      || die "TRUST_UNREADABLE: the cursor in $wid's trust dialog isn't in the option list (options: $opts); nothing was pressed"
  done
  moves=$(( yes - cur ))
  while (( moves > 0 )); do keys+=(down); moves=$((moves - 1)); done
  while (( moves < 0 )); do keys+=(up); moves=$((moves + 1)); done
  keys+=(enter)
  cmd_key "$wid" "${keys[@]}" >/dev/null
  log_event "trust $wid: accepted (${keys[*]})"
  # Claude Code runs its SessionStart hook once the folder is trusted.
  for (( i = 0; i < 30; i++ )); do
    if [[ -f "$d/session.json" ]]; then echo "accepted the trust dialog in $wid (${keys[*]}); it is starting"; return 0; fi
    sleep 0.5
  done
  echo "pressed ${keys[*]} in $wid's trust dialog, but it hasn't started within 15s; look at 'brig screen $wid'"
}

cmd_kill() {
  local wid="${1:?usage: brig kill <wid>}"
  open_run
  local sid; sid="$(target_surface "$wid")"; [[ -n "$sid" ]] || die "$wid has no terminal"
  [[ "$wid" == successor ]] || echo closed >"$(wdir "$wid")/.state"
  if be_live_ids 2>/dev/null | grep -qxF "$sid"; then be_close "$sid"; fi
  log_event "kill $wid"
  echo "closed $wid"
}

cmd_last() {
  open_run
  local d; d="$(wdir "${1:?usage: brig last <wid>}")"
  if [[ -f "$d/stop.json" ]]; then jq -r '.last_assistant_message // ""' "$d/stop.json"; else echo "(no turn has ended yet)"; fi
}
cmd_screen() {
  open_run
  local sid; sid="$(target_surface "${1:?usage: brig screen <wid> [lines]}")"
  be_read "$sid" "${2:-40}"
}

# brig rebirth [note-file]: hand this run to a fresh brigadier session, wait until it confirms
# (it runs 'brig ack' once it has recovered), then close this tab. Run it in the background.
cmd_rebirth() {
  local note="${1:-}"
  [[ -z "${BRIG_WORKER:-}" ]] || die "workers hand off with handoff.md; rebirth is for the brigadier"
  open_run
  if [[ -n "$note" ]]; then note="$(abspath "$note")"; [[ -f "$note" ]] || die "no such note: $1"; fi
  check_permission_mode
  # The brigadier runs on the user's own default model: a model directive in the goal covers the
  # workers, so the run's config.env doesn't apply here.
  local model="$USER_DEFAULT_MODEL"
  model_allowed "$model" "$USER_ALLOWED_MODELS" || die "BRIG_DEFAULT_MODEL=$model is not in BRIG_ALLOWED_MODELS ($USER_ALLOWED_MODELS); fix $USER_CONFIG"
  local prompt="${SLASH:-/brigadier} resume $RUN_ID"
  [[ -n "$note" ]] && prompt+=". First read $(native_path "$note"): it is the previous brigadier's note to you."
  local skip=false; [[ "$BRIG_PERMISSION_MODE" == bypassPermissions ]] && skip=true
  jq -n --argjson skip "$skip" '{skipDangerousModePermissionPrompt: $skip}' >"$RUN/rebirth-settings.json"
  {
    echo '#!/usr/bin/env bash'
    echo "# Fresh brigadier for run $RUN_ID (written by brig rebirth)."
    echo "cd $(q "$REPO") || exit 1"
    clean_env_lines
    win_launch_lines
    echo "export BRIG_RUN=$(q "$RUN")"
    printf 'exec claude --permission-mode %s --settings %s --model %s --effort %s --name %s %s\n' \
      "$(q "$BRIG_PERMISSION_MODE")" "$(q "$(native_path "$RUN/rebirth-settings.json")")" "$(q "$model")" "$(q "$BRIG_DEFAULT_EFFORT")" \
      "$(q "Brigadier · ${RUN_ID#*-*-}")" "$(q "$prompt")"
  } >"$RUN/rebirth.sh"
  chmod +x "$RUN/rebirth.sh"
  rm -f "$RUN/rebirth.ack"
  local self; self="$(be_self_id)"
  local sid; sid="$(be_spawn "$REPO" "$RUN/rebirth.sh" "◆ Brigadier · ${RUN_ID#*-*-}")" || die "could not open a terminal for the new brigadier"
  echo "$sid" >"$RUN/rebirth.surface"
  log_event "rebirth started -> surface $sid"
  echo "new brigadier starting in $sid; waiting up to ${BRIG_REBIRTH_TIMEOUT}s for it to confirm (brig ack)"
  local deadline=$(( $(now) + BRIG_REBIRTH_TIMEOUT )) ids
  while [[ ! -f "$RUN/rebirth.ack" ]]; do
    if (( $(now) >= deadline )); then
      log_event "rebirth timeout: $sid never confirmed"
      echo "REBIRTH_TIMEOUT: the new brigadier ($sid) did not confirm within ${BRIG_REBIRTH_TIMEOUT}s. This session stays in charge. Look at it with 'brig screen successor', close it with 'brig kill successor', then carry on."
      return 1
    fi
    if ids="$(be_live_ids 2>/dev/null)" && ! grep -qxF "$sid" <<<"$ids"; then
      log_event "rebirth failed: $sid closed before confirming"
      echo "REBIRTH_FAILED: the new brigadier's terminal ($sid) closed before it confirmed. This session stays in charge."
      return 1
    fi
    sleep 2
  done
  log_event "rebirth confirmed by $sid"
  if [[ -n "$self" ]]; then
    echo "REBIRTH_OK: the new brigadier confirmed. Closing this tab in 5s."
    # The closer outlives this process: it loads the run's backend itself, with the helpers backends use.
    local helpers; helpers="$(declare -f die q is_windows native_path posix_path jq 2>/dev/null || true)"
    nohup "${BASH:-bash}" -c "$helpers
      IS_WINDOWS=$(q "$IS_WINDOWS") JQ_EXE=$(q "${JQ_EXE:-}")
      source $(q "$RUN/run.env")
      source $(q "$SKILL_DIR/scripts/backends/$BACKEND.sh")
      sleep 5; be_close $(q "$self")" >/dev/null 2>&1 &
    disown || true
  else
    echo "REBIRTH_OK: the new brigadier confirmed and now runs this run. $(be_watch_hint) This session can stop here; close it whenever you like."
  fi
}

# brig ack: a reborn brigadier confirms it has recovered (ledger read, wait started).
cmd_ack() {
  open_run
  bind_identity "$RUN"
  { identity; date '+%Y-%m-%d %H:%M:%S'; } >"$RUN/rebirth.ack"
  log_event "ack from $(identity || true)"
  echo "acknowledged"
}

cmd_status() {
  open_run
  printf '%-5s %-7s %-9s %-5s %-6s %-5s %-28s %s\n' WID STATE STATUS CTX BUSY 5H MODEL TITLE
  local w d summary="" st b
  for w in $(workers); do
    d="$RUN/workers/$w"
    st="$(readf "$d/.state" '?')"; b="idle"; busy "$d" && b="busy"; [[ "$st" == closed ]] && b="-"
    printf '%-5s %-7s %-9s %-5s %-6s %-5s %-28s %s\n' "$w" "$st" "$(readf "$d/status" '-')" "$(ctx_label "$d")" "$b" "$(rate_pct "$d")%" "$(readf "$d/model")" "$(readf "$d/title")"
    [[ "$st" == live ]] && summary+="$w $b ctx$(ctx_label "$d") · "
  done
  be_status "${summary% · }"
  [[ "$MODE" == background ]] && be_watch_hint
  true
}

cmd_watch() {
  while :; do
    clear 2>/dev/null || true
    echo "Brigadier · $(date '+%H:%M:%S')"; echo
    ( cmd_status ) 2>&1 || true
    echo; echo "This window only shows status. Leave tmux without stopping anything: Ctrl-b d"
    sleep "${BRIG_WATCH_INTERVAL:-5}"
  done
}

# brig check: after a restart, compare each live worker's busy flag with its screen.
cmd_check() {
  open_run
  local w d flag st verdict
  for w in $(live_workers); do
    d="$RUN/workers/$w"
    if [[ "$(agent_of "$d")" != claude ]]; then echo "$w codex (no screen check)"; continue; fi
    if busy "$d"; then flag=busy; else flag=idle; fi; st="$(screen_state "$d")"
    verdict=ok
    [[ $flag == busy && ( $st == interrupted || $st == idle ) ]] && verdict="INTERRUPTED: tell it to clean up and continue"
    [[ $st == background ]] && verdict="ok: waiting on its own background job"
    [[ $st == trust ]] && verdict="TRUST_PROMPT: Claude Code asks whether to trust the folder (brig screen $w; accept with brig trust $w)"
    [[ $flag == idle && $(readf "$d/status") == working ]] && verdict="waiting for your answer (brig last $w)"
    echo "$w flag=$flag screen=$st status=$(readf "$d/status" -) :: $verdict"
  done
}

# brig wait [timeout-seconds]: block until a worker needs attention, then print events.
cmd_wait() {
  local timeout="${1:-1800}"
  open_run
  local deadline=$(( $(now) + timeout ))
  while :; do
    local events=() surfaces="" have_surfaces=""
    if surfaces="$(be_live_ids 2>/dev/null)"; then have_surfaces=1; fi
    if [[ -z "${BRIG_WORKER:-}" && -n "${CLAUDE_CODE_SESSION_ID:-}" && "$(readf "$RUN/.rebirth_flag")" != "$CLAUDE_CODE_SESSION_ID" ]]; then
      local st_; st_="$(self_tokens)"
      if (( st_ >= BRIG_SELF_TOKENS )); then
        echo "$CLAUDE_CODE_SESSION_ID" >"$RUN/.rebirth_flag"
        events+=("REBIRTH_DUE your own context is ~$(( st_ / 1000 ))k tokens (limit $(( BRIG_SELF_TOKENS / 1000 ))k): update the ledger, then 'brig rebirth [note-file]' in the background")
      fi
    fi
    local w d
    for w in $(live_workers); do
      d="$RUN/workers/$w"
      local sm seen; sm="$(mtime "$d/stop.json")"; seen="$(readf "$d/.seen_stop" 0)"
      if [[ -n "$have_surfaces" ]] && ! grep -qxF "$(readf "$d/surface")" <<<"$surfaces"; then
        events+=("GONE $w: its terminal no longer exists (crashed or closed by hand)")
        echo closed >"$d/.state"; continue
      fi
      if (( sm > seen )); then
        echo "$sm" >"$d/.seen_stop"
        local msg; msg="$(jq -r '.last_assistant_message // ""' "$d/stop.json" | tr '\n' ' ' | cut -c1-300)"
        events+=("TURN_END $w status=$(readf "$d/status" '-') ctx=$(ctx_label "$d") :: $msg")
      fi
      if [[ "$(agent_of "$d")" == claude ]]; then
        # No hook runs before the trust dialog is answered, so only a worker without session.json can be at it.
        if [[ ! -f "$d/session.json" && ! -f "$d/.trust_flag" ]] && (( $(now) - $(mtime "$d/launch.sh") >= 3 )); then
          local ts; ts="$(be_read "$(readf "$d/surface")" 30 2>/dev/null || true)"
          if is_trust_screen "$ts"; then
            touch "$d/.trust_flag"
            local td; td="$(trust_dir_of "$ts")"
            events+=("TRUST_PROMPT $w: Claude Code asks whether to trust ${td:-$(native_path "$REPO")} [options: $(trust_options_of "$ts")]. If it is this run's repo, or a worktree or subfolder of it, accept with 'brig trust $w'; otherwise 'brig kill $w' and put the folder under Waiting on you")
          fi
        fi
        local c t; c="$(ctx_pct "$d")"; t="$(ctx_tokens "$d")"
        if (( c >= BRIG_CTX_PCT || t >= BRIG_CTX_TOKENS )) && [[ ! -f "$d/.ctx_flag" ]]; then
          touch "$d/.ctx_flag"; events+=("CTX_HIGH $w ctx=${c}% (~$(( t / 1000 ))k tokens; limits ${BRIG_CTX_PCT}% / $(( BRIG_CTX_TOKENS / 1000 ))k): send 'brig handoff $w'")
        fi
        if [[ -f "$d/precompact.json" && ! -f "$d/.compact_flag" ]]; then
          touch "$d/.compact_flag"; events+=("COMPACTING $w: auto-compaction started before handoff; ask for a handoff right after it finishes")
        fi
        local nl ns; nl=0; [[ -f "$d/notify.jsonl" ]] && nl="$(wc -l <"$d/notify.jsonl" | tr -d ' ')"; ns="$(readf "$d/.seen_notify" 0)"
        if (( nl > ns )); then
          echo "$nl" >"$d/.seen_notify"
          local n; while IFS= read -r n; do
            case "$(jq -r '.notification_type // ""' <<<"$n")" in
              permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input)
                events+=("NEEDS_INPUT $w: $(jq -r '.message // .notification_type' <<<"$n" | cut -c1-200); inspect with 'brig screen $w'") ;;
              quota_auto_resume_*) events+=("QUOTA $w: $(jq -r '.notification_type' <<<"$n")") ;;
            esac
          done < <(tail -n "$(( nl - ns ))" "$d/notify.jsonl")
        fi
        local rp rr; rp="$(rate_pct "$d")"; rr="$(rate_reset "$d")"
        if (( rp >= BRIG_RATE_PCT )) && [[ "$(readf "$RUN/.rate_flag")" != "$rr" ]]; then
          echo "$rr" >"$RUN/.rate_flag"
          events+=("RATE_LIMIT Claude 5h window at ${rp}%, resets $(hhmm "$rr") (epoch $rr)")
        fi
      fi
      if [[ "$(agent_of "$d")" == codex ]]; then
        local rl rs; rl=0; [[ -f "$d/inbox-rejected.log" ]] && rl="$(wc -l <"$d/inbox-rejected.log" | tr -d ' ')"; rs="$(readf "$d/.seen_rejected" 0)"
        if (( rl > rs )); then
          echo "$rl" >"$d/.seen_rejected"
          local r; while IFS= read -r r; do
            events+=("REJECTED $w: a queued message was refused ($(cut -d' ' -f3- <<<"$r")) and not delivered; resend it with brig send")
          done < <(tail -n "$(( rl - rs ))" "$d/inbox-rejected.log")
        fi
      fi
      if busy "$d"; then
        local tm; tm="$(transcript_mtime "$d")"
        if [[ "$(agent_of "$d")" == claude ]] && (( $(now) - tm > BRIG_IDLE_SEC )) && [[ "$(readf "$d/.screen_flag")" != "$tm" ]]; then
          local ss; ss="$(screen_state "$d")"
          case "$ss" in
            interrupted|idle)
              echo "$tm" >"$d/.screen_flag"
              events+=("INTERRUPTED $w: marked busy but its screen is $ss (a cut-off turn fires no Stop hook); check 'brig screen $w', then tell it to clean up and continue") ;;
          esac
        fi
        if (( $(now) - tm > BRIG_STALL_MIN * 60 )) && [[ "$(readf "$d/.stall_flag")" != "$tm" ]]; then
          echo "$tm" >"$d/.stall_flag"
          events+=("STALL $w: busy but no transcript activity for $(( ($(now) - tm) / 60 )) min; check 'brig screen $w'")
        fi
      fi
    done
    if (( ${#events[@]} )); then
      local e; for e in "${events[@]}"; do log_event "$e"; echo "» $e"; done
      echo; cmd_status; return 0
    fi
    if [[ -z "$(live_workers)" ]]; then echo "NO_LIVE_WORKERS"; cmd_status; return 0; fi
    if (( $(now) >= deadline )); then echo "HEARTBEAT (no events for ${timeout}s)"; cmd_status; return 0; fi
    sleep "$BRIG_POLL"
  done
}

# brig finish "<one-line outcome>": mark the run finished, notify, tidy the terminal.
cmd_finish() {
  open_run
  local msg="${1:-Run finished}"
  date '+%Y-%m-%d %H:%M' >"$RUN/finished"
  be_status_clear
  be_notify "Brigadier finished" "$msg — REPORT: $RUN/REPORT.md"
  be_finish
  log_event "finish: $msg"
  echo "finished $RUN_ID (report: $RUN/REPORT.md)"
}

# brig review code (--base REF | --commit SHA | --uncommitted) [--repo DIR] [--out FILE] [--effort E] [--focus TEXT]
# brig review plan <file> [--repo DIR] [--out FILE] [--effort E] [--focus TEXT]
# Read-only review by Codex when available, else by a read-only Claude session. Prints and saves it.
cmd_review() {
  local kind="${1:?usage: brig review code|plan ...}"; shift
  local target=() plan="" out="" effort="" focus="" repo=""
  if [[ "$kind" == plan ]]; then plan="${1:?plan file}"; shift; [[ -f "$plan" ]] || die "no such file: $plan"; plan="$(abspath "$plan")"; fi
  while (( $# )); do
    case "$1" in
      --base|--commit) target=("$1" "$2"); shift 2 ;;
      --uncommitted) target=(--uncommitted); shift ;;
      --repo) repo="$2"; shift 2 ;;
      --out) out="$(abspath "$2")"; shift 2 ;;
      --effort) effort="$2"; shift 2 ;;
      --focus) focus="$2"; shift 2 ;;
      *) die "review: unknown flag $1" ;;
    esac
  done
  if RUN="$(run_dir 2>/dev/null)"; then load_config "$RUN"; fi
  effort="${effort:-$BRIG_DEFAULT_EFFORT}"
  check_effort "$effort"
  local who; who="$(reviewer)"
  [[ "$who" != off ]] || die "reviews are off (BRIG_REVIEWER=off)"
  [[ -n "$out" ]] || out="$(mktemp "${TMPDIR:-/tmp}/brig-review.XXXXXX")"
  # shellcheck disable=SC1091
  if [[ -z "$repo" ]]; then
    if git rev-parse --show-toplevel >/dev/null 2>&1; then repo="$(git rev-parse --show-toplevel)"
    elif [[ -n "${RUN:-}" ]]; then repo="$(source "$RUN/run.env"; echo "$REPO")"
    else die "review: not in a git checkout; pass --repo DIR"; fi
  fi
  [[ -d "$repo" ]] || die "review: no such repo $repo"
  local scope="" prompt
  case "$kind" in
    code)
      (( ${#target[@]} )) || die "review code needs --base REF, --commit SHA or --uncommitted"
      if [[ "${target[0]}" == --base ]]; then
        git -C "$repo" rev-parse --verify -q "${target[1]}^{commit}" >/dev/null || die "review: ${target[1]} is not a commit in $repo"
        [[ -n "$(git -C "$repo" diff --name-only "${target[1]}"...HEAD)" ]] \
          || die "review: no changes between ${target[1]} and HEAD in $repo (wrong checkout? pass --repo DIR)"
      fi
      case "${target[0]}" in
        --base) scope="the changes in \`git diff ${target[1]}...HEAD\` (commits \`git log ${target[1]}..HEAD\`)" ;;
        --commit) scope="the changes in commit ${target[1]} (\`git show ${target[1]}\`)" ;;
        *) scope="the uncommitted changes (\`git diff HEAD\` plus untracked files)" ;;
      esac
      prompt="Review $scope in this repository. Report concrete bugs and risks with file:line, severity (high/medium/low) and the fix you recommend. Do not modify any files.${focus:+ Focus only on: $focus.}"
      ;;
    plan)
      prompt="Review the implementation plan in $(native_path "$plan") for the project in this repository. Read it, and the project's own plan and decision documents it relies on (e.g. docs/, AGENTS.md, CLAUDE.md, README). Report only concrete problems: contradictions with the project's documented plan or settled decisions, missing or out-of-scope work, wrong or outdated libraries, versions or APIs, risky ordering, needless complexity. For each problem give severity (high/medium/low), the issue, and the fix you recommend. End with one verdict line: APPROVE, APPROVE WITH CHANGES, or REVISE. Do not modify any files.${focus:+ Focus: $focus}"
      ;;
    *) die "review kind must be code or plan" ;;
  esac
  echo "reviewing $repo with $who" >&2
  if [[ "$who" == codex ]]; then
    local cfg=(-c "model_reasoning_effort=\"$effort\"")
    if [[ "$kind" == code && -z "$focus" ]]; then
      (cd "$repo" && codex exec review --ephemeral "${cfg[@]}" "${target[@]}" -o "$out" </dev/null >/dev/null 2>&1) || die "codex review failed"
    else
      # `codex exec review` rejects a custom prompt together with --base/--commit/--uncommitted,
      # so a focused review (and a plan review) runs as a read-only exec with the scope in the prompt.
      (cd "$repo" && codex exec --ephemeral -s read-only "${cfg[@]}" -o "$out" "$prompt" </dev/null >/dev/null 2>&1) || die "codex review failed"
    fi
  else
    local model; model="$(claude_model "")"
    (cd "$repo" && printf '%s' "$prompt" | env -u CLAUDECODE claude -p --model "$model" --effort "$effort" --permission-mode dontAsk \
      --allowedTools "Read" "Grep" "Glob" "Bash(git diff:*)" "Bash(git log:*)" "Bash(git show:*)" "Bash(git status:*)" \
      --disallowedTools "Edit" "Write" "NotebookEdit" >"$out" 2>/dev/null) || die "claude review failed"
  fi
  cat "$out"; echo; echo "(saved to $out)"
}

cmd_config() {
  local r="" k src
  if r="$(run_dir 2>/dev/null)"; then load_config "$r"; fi
  echo "user config: $USER_CONFIG $([[ -f "$USER_CONFIG" ]] && echo "(found)" || echo "(not created; copy $SKILL_DIR/config.example.env there to change settings)")"
  [[ -n "$r" ]] && echo "run config:  $r/config.env $([[ -f "$r/config.env" ]] && echo "(found)" || echo "(none)")"
  for k in $BRIG_KEYS; do
    if [[ "$ENV_SET" == *" $k "* ]]; then src="env"
    elif [[ " $RUN_IGNORED " == *" $k "* ]]; then src="user (the run's value is ignored: a run may tighten your limits, not loosen them)"
    elif [[ -n "$r" && -f "$r/config.env" ]] && grep -Eq "^(export )?$k=" "$r/config.env"; then src=run
    elif [[ -f "$USER_CONFIG" ]] && grep -Eq "^(export )?$k=" "$USER_CONFIG"; then src=user
    else src=default; fi
    printf '%-22s %-24s %s\n' "$k" "${!k}" "$src"
  done
}

# Skill files with Windows line endings (a checkout made with core.autocrlf=true).
crlf_files() { grep -rlI $'\r' "$SKILL_DIR" 2>/dev/null || true; }
claude_install_hint() {
  if is_windows; then echo "Install Claude Code: $(pkg_cmd windows claude) (or see $CLAUDE_INSTALL_HINT)"
  else echo "Install Claude Code: see $CLAUDE_INSTALL_HINT"; fi
}

cmd_doctor() {
  local bad=0 v b
  ok() { printf '  ok    %s\n' "$*"; }
  warn() { printf '  note  %s\n' "$*"; }
  no() { printf '  FAIL  %s\n' "$*"; bad=1; }
  if is_windows; then PATH="$(path_with_tools)"; fi
  echo "brig doctor (Brigadier $BRIG_VERSION)"
  if (( BASH_VERSINFO[0] > 3 || (BASH_VERSINFO[0] == 3 && BASH_VERSINFO[1] >= 2) )); then ok "bash $BASH_VERSION"; else no "bash $BASH_VERSION is too old (need 3.2+)"; fi
  if is_windows; then
    ok "Windows, Git Bash ($(uname -s))"
    if [[ -n "${CLAUDE_CODE_GIT_BASH_PATH:-}" && ! -f "${CLAUDE_CODE_GIT_BASH_PATH}" ]]; then
      no "CLAUDE_CODE_GIT_BASH_PATH=$CLAUDE_CODE_GIT_BASH_PATH doesn't exist; point it at Git's bin\\bash.exe or remove it"
    elif v="$(git_bash)"; then ok "hooks and workers run $v"
    else no "Git Bash's bash.exe not found; set CLAUDE_CODE_GIT_BASH_PATH to it (e.g. C:\\Program Files\\Git\\bin\\bash.exe)"; fi
  fi
  v="$(crlf_files | wc -l | tr -d ' ')"
  if (( v > 0 )); then no "$v skill files have Windows line endings (CRLF); run /brigadier setup to fix them"; fi
  if ! command -v jq >/dev/null 2>&1; then no "jq not found. $(install_hint jq)"
  # On Windows every jq call passes -b (no CRs), which needs a recent jq.
  elif is_windows && ! jq -n 1 >/dev/null 2>&1; then no "jq can't run with -b, which Windows needs; upgrade it with: winget upgrade --id jqlang.jq -e --source winget"
  else ok "jq $(jq --version 2>/dev/null)"; fi
  if command -v git >/dev/null 2>&1; then ok "$(git --version)"; else no "git not found. $(install_hint git)"; fi
  if command -v claude >/dev/null 2>&1; then ok "claude $(claude --version 2>/dev/null | head -1)"
  else no "claude not on PATH. $(claude_install_hint)"; fi
  if [[ "$BRIG_CODEX" == off ]]; then warn "Codex off (BRIG_CODEX=off); reviews use Claude"
  elif command -v codex >/dev/null 2>&1; then ok "codex $(codex --version 2>/dev/null | head -1) (reviews and Codex workers on)"
  else warn "codex not found (optional): reviews use a read-only Claude session; install the Codex CLI to add a second reviewer and Codex workers"; fi
  if b="$(pick_backend)"; then
    if [[ "$b" == cmux ]]; then
      if [[ -n "${CMUX_WORKSPACE_ID:-}" ]] && command -v cmux >/dev/null 2>&1; then ok "terminal: cmux (workspace $CMUX_WORKSPACE_ID)"
      else no "BRIG_BACKEND=cmux but this isn't a cmux terminal (or cmux isn't on PATH)"; fi
    elif [[ "$b" == wmux ]]; then
      if [[ "$(wmux_flavor)" == amirlehmam ]] && command -v wmux >/dev/null 2>&1; then ok "$(wmux_doctor_line wmux)"
      else no "BRIG_BACKEND=wmux (amirlehmam/wmux), but this isn't one of its tabs with the wmux CLI on PATH. $(wmux_install_steps)"; fi
    elif [[ "$b" == wmux-ow ]]; then
      if [[ -n "${WMUX_PTY_ID:-}" ]] && command -v powershell.exe >/dev/null 2>&1; then ok "$(wmux_doctor_line wmux-ow)"
      else no "BRIG_BACKEND=wmux-ow (openwong2kim/wmux), but this isn't one of its tabs, or powershell.exe isn't on PATH. $(wmux_install_steps)"; fi
    elif [[ "$b" == tmux ]]; then
      if ! command -v tmux >/dev/null 2>&1; then no "tmux not found. $(install_hint tmux)"
      elif [[ -n "${TMUX:-}" && "$BRIG_TMUX_MODE" != background ]]; then ok "terminal: tmux $(tmux -V | cut -d' ' -f2), attached (workers open as windows in this session)"
      else ok "terminal: tmux $(tmux -V | cut -d' ' -f2), background mode (workers run in a detached session brigadier-<slug>; watch with: tmux attach -t brigadier-<slug>, leave with Ctrl-b d)"; fi
    elif [[ -f "$SKILL_DIR/scripts/backends/$b.sh" ]]; then ok "terminal: $b (BRIG_BACKEND)"
    else no "BRIG_BACKEND=$b: no such backend in $SKILL_DIR/scripts/backends"; fi
  else
    no "no terminal backend: $(no_terminal_msg)"
  fi
  if mkdir -p "$BRIG_HOME" 2>/dev/null && [[ -w "$BRIG_HOME" ]]; then ok "state dir $BRIG_HOME"; else no "cannot write $BRIG_HOME (set BRIG_HOME to a writable dir)"; fi
  if [[ -f "$USER_CONFIG" ]]; then
    if (set +u; source_file "$USER_CONFIG") >/dev/null 2>&1; then ok "config $USER_CONFIG"; else no "config $USER_CONFIG has a shell syntax error"; fi
  else warn "no config file yet; defaults apply (/brigadier setup creates one to edit)"; fi
  if (( $(effort_rank "$BRIG_MAX_EFFORT") == 0 )); then no "BRIG_MAX_EFFORT=$BRIG_MAX_EFFORT is not low|medium|high|xhigh|max"
  elif (( $(effort_rank "$BRIG_DEFAULT_EFFORT") == 0 || $(effort_rank "$BRIG_DEFAULT_EFFORT") > $(effort_rank "$BRIG_MAX_EFFORT") )); then
    no "BRIG_DEFAULT_EFFORT=$BRIG_DEFAULT_EFFORT must be a valid effort at or below BRIG_MAX_EFFORT=$BRIG_MAX_EFFORT"
  else ok "effort: default $BRIG_DEFAULT_EFFORT, max $BRIG_MAX_EFFORT"; fi
  if model_allowed "$BRIG_DEFAULT_MODEL"; then ok "models: default $BRIG_DEFAULT_MODEL, chores $BRIG_CHORE_MODEL, allowed: $BRIG_ALLOWED_MODELS"
  else no "BRIG_DEFAULT_MODEL=$BRIG_DEFAULT_MODEL is not in BRIG_ALLOWED_MODELS ($BRIG_ALLOWED_MODELS)"; fi
  if v="$( (check_permission_mode) 2>&1)"; then ok "$(posture)"; else no "${v#brig: }"; fi
  if (( bad == 0 )); then echo "all good"; else echo "fix the FAIL lines first (/brigadier setup prints the exact commands)"; return 1; fi
}

# brig setup [--install [--yes] [--wmux-ow]]: everything a new machine needs, then doctor.
# Prints the exact install command for anything missing; runs package-manager installs only with
# --install, after a yes on a terminal or --yes (which the skill passes only after the user agreed
# in chat to the commands shown). Never overwrites a file. Safe to run again.
cmd_setup() {
  local install="" yes="" ow="" a
  for a in "$@"; do
    case "$a" in
      --install) install=1 ;;
      --yes) yes=1 ;;
      --wmux-ow) ow=1 ;;
      *) die "usage: brig setup [--install [--yes] [--wmux-ow]]" ;;
    esac
  done
  [[ -z "${BRIG_WORKER:-}" ]] || die "workers don't run setup"
  local os pkgs=() manual=() cmds=() line wmux_alt=""
  os="$(os_kind)"
  if is_windows; then PATH="$(path_with_tools)"; fi
  item() { printf '  %-8s %s\n' "$1" "$2"; }
  echo "brig setup (Brigadier $BRIG_VERSION)"
  case "$os" in
    macos) line="macOS$(command -v brew >/dev/null 2>&1 && echo " (Homebrew)" || echo ", no Homebrew")" ;;
    windows) line="Windows, Git Bash$(command -v winget >/dev/null 2>&1 && echo " (winget)" || echo ", no winget")" ;;
    linux) line="Linux (unknown distribution)" ;;
    *) line="Linux ($os)" ;;
  esac
  [[ "$os" != windows && -n "${WSL_DISTRO_NAME:-}" ]] && line+=", WSL"
  echo "platform: $line"

  echo "tools:"
  local t
  for t in git jq; do
    if command -v "$t" >/dev/null 2>&1; then item ok "$t"; else item missing "$t"; pkgs+=("$t"); fi
  done
  if command -v claude >/dev/null 2>&1; then item ok claude; else item missing "claude: $(claude_install_hint)"; manual+=("claude: $(claude_install_hint)"); fi
  if [[ "$os" == windows ]]; then
    if [[ "$(wmux_flavor)" == amirlehmam ]] && command -v wmux >/dev/null 2>&1; then item ok "wmux (this tab, amirlehmam/wmux)"
    elif [[ "$(wmux_flavor)" == openwong2kim ]] && command -v powershell.exe >/dev/null 2>&1; then item ok "wmux (this tab, openwong2kim/wmux: supported as the fallback)"
    else
      item missing "wmux: $(no_terminal_msg)"; manual+=("wmux: $(no_terminal_msg)")
      # The alternative is a package-manager install, so it may run with --install like the others.
      if [[ -z "$(wmux_flavor)" ]] && command -v winget >/dev/null 2>&1; then wmux_alt="$WMUX_OW_WINGET"; fi
    fi
  elif [[ -n "${CMUX_WORKSPACE_ID:-}" ]] && command -v cmux >/dev/null 2>&1; then item ok "cmux (this workspace)"
  elif command -v tmux >/dev/null 2>&1; then item ok tmux
  else item missing tmux; pkgs+=(tmux); fi
  if command -v codex >/dev/null 2>&1; then item ok "codex (optional)"; else item note "codex (optional) not found: reviews use Claude"; fi

  echo "files:"
  if mkdir -p "$BRIG_HOME" 2>/dev/null && [[ -w "$BRIG_HOME" ]]; then item ok "state dir $BRIG_HOME"; else item FAIL "cannot write $BRIG_HOME"; fi
  if [[ -f "$USER_CONFIG" ]]; then
    if grep -q $'\r' "$USER_CONFIG"; then
      cp "$USER_CONFIG" "$USER_CONFIG.bak" && tr -d '\r' <"$USER_CONFIG.bak" >"$USER_CONFIG" \
        && item fixed "config $USER_CONFIG had Windows line endings (original kept as config.env.bak)"
    else item ok "config $USER_CONFIG (left as it is)"; fi
  elif [[ -d "$BRIG_HOME" ]]; then
    { echo "# Created by 'brig setup'. Every setting is commented out, so the defaults apply and follow"
      echo "# new releases. Uncomment a line to change it."
      sed -E 's/^([A-Z_]+=)/# \1/' "$SKILL_DIR/config.example.env"; } >"$USER_CONFIG" \
      && item created "config $USER_CONFIG (all settings commented out; defaults apply)"
  fi
  local f n=0
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    # brig is running right now; bash reads scripts as it goes, so it is never rewritten in place.
    if [[ "$f" -ef "$BRIG_SCRIPT" ]]; then item FAIL "$f has Windows line endings; reinstall the skill"; continue; fi
    tr -d '\r' <"$f" >"$f.lf.tmp" && mv -f "$f.lf.tmp" "$f" && n=$((n + 1))
  done < <(crlf_files)
  if (( n > 0 )); then item fixed "Windows line endings in $n skill files"; else item ok "skill files have Unix line endings"; fi

  if (( ${#pkgs[@]} )); then
    local c; c="$(pkg_cmd "$os" "${pkgs[@]}")"
    if [[ -z "$c" ]]; then manual+=("${pkgs[*]}: install with your package manager")
    elif [[ "$os" == macos ]] && ! command -v brew >/dev/null 2>&1; then
      manual+=("Homebrew is needed for: $c (get Homebrew from https://brew.sh)")
    elif [[ "$os" == windows ]] && ! command -v winget >/dev/null 2>&1; then
      manual+=("winget (App Installer, from the Microsoft Store) is needed for: $c")
    else cmds+=("$c"); fi
  fi
  if [[ -n "$wmux_alt" ]]; then cmds+=("$wmux_alt"); fi

  if (( ${#cmds[@]} + ${#manual[@]} )); then
    echo "to do:"
    for c in ${manual[@]+"${manual[@]}"}; do echo "  by hand: $c"; done
    for c in ${cmds[@]+"${cmds[@]}"}; do
      if [[ "$c" == "$wmux_alt" ]]; then echo "  run:  $c   (only if you choose openwong2kim/wmux over amirlehmam/wmux; setup runs it with --install --wmux-ow)"
      else echo "  run:  $c"; fi
    done
  fi
  if (( ${#cmds[@]} )); then
    if [[ -z "$install" ]]; then
      echo "Nothing was installed. Run the commands above yourself, or 'brig setup --install' to have setup run them."
    else
      local go=""
      if [[ -n "$yes" ]]; then go=1
      elif [[ -t 0 ]]; then read -r -p "Run these now? [y/N] " a; [[ "$a" == [yY]* ]] && go=1
      else echo "Not installing: there's no terminal to confirm in. Review the commands above, then run 'brig setup --install --yes'."; fi
      if [[ -n "$go" ]]; then
        for c in "${cmds[@]}"; do
          if [[ "$c" == "$wmux_alt" && -z "$ow" ]]; then echo "  skipped: $c (add --wmux-ow to install openwong2kim/wmux)"; continue; fi
          if [[ "$c" == sudo\ * && ! -t 0 ]] && ! sudo -n true 2>/dev/null; then
            echo "  needs your password, so run it yourself (in Claude Code: ! $c)"; continue
          fi
          echo "  \$ $c"
          bash -c "$c" || echo "  that command failed (exit $?)"
        done
        if is_windows; then
          PATH="$(path_with_tools)"
          for t in ${pkgs[@]+"${pkgs[@]}"}; do
            command -v "$t" >/dev/null 2>&1 \
              || echo "  $t is installed but this terminal can't see it yet: restart wmux and Claude Code, then run /brigadier setup again."
          done
        fi
      fi
    fi
  fi

  echo
  cmd_doctor
}

cmd_version() { echo "brig $BRIG_VERSION"; }

cmd_help() {
  cat <<EOF
brig $BRIG_VERSION: Brigadier worker control (runs live in $BRIG_HOME/runs)
  setup [--install [--yes] [--wmux-ow]]  set this machine up (prints install commands; runs them only with --install), then doctor
  doctor                          check this machine (terminal backend, claude, codex, jq, config)
  config                          effective settings and where each comes from
  init <slug> [--slash CMD]       new run in this repo; prints BRIG_RUN=<run-id> (pass it on every later call)
  use <run-id> | run              bind this session to a run / print the bound run
  runs [--here | --overlap]       list runs (state, start, last event, repo, goal); --here: this repo only;
                                  --overlap: other runs on this run's repo that were active during it
  spawn <wid> <task-file> [--agent claude|codex] [--title T] [--model M] [--effort E] [--continues WID]...
  send <wid> <text> | --file F    message a worker (typed into Claude; queued for Codex); long text goes in a file
  key <wid|successor> <key>...    press keys in order to answer a dialog: enter, escape, up, down, left, right, tab, space, 1-9
  trust <wid>                     accept Claude Code's "trust this folder" dialog (reads it first; presses nothing it can't read)
  handoff <wid>                   standard "write handoff.md and stop" request
  wait [seconds]                  block until an event: TURN_END, CTX_HIGH, COMPACTING, NEEDS_INPUT, TRUST_PROMPT, INTERRUPTED,
                                  STALL, GONE, REJECTED, RATE_LIMIT, REBIRTH_DUE, NO_LIVE_WORKERS or HEARTBEAT
  status | watch                  table of workers / refreshing table (background tmux mode shows it in window 0)
  check                           busy flag vs screen per worker: finds turns cut off by Esc or a restart
  last <wid>                      the worker's last reply in full
  screen <wid|successor> [lines]  the worker's terminal screen
  kill <wid|successor>            close a worker's terminal
  rebirth [note-file]             brigadier only: start a fresh brigadier for this run, wait for its 'brig ack', then close this one
  ack                             a reborn brigadier confirms it has recovered
  finish "<outcome>"              mark the run finished, notify, clean up the background tmux session
  review code (--base REF|--commit SHA|--uncommitted) [--repo DIR] [--out F] [--effort E] [--focus T]
  review plan <file> [--repo DIR] [--out F] [--effort E] [--focus T]
                                  read-only review: Codex if available, else Claude (BRIG_REVIEWER)
  version | help
Settings: $USER_CONFIG, per run <run>/config.env, or BRIG_* environment variables (see config.example.env).
EOF
}

sub="${1:-help}"; shift || true
case "$sub" in
  _hook) cmd__hook "$@" ;;
  -h|--help) cmd_help ;;
  --version) cmd_version ;;
  init|use|run|runs|spawn|send|key|trust|handoff|kill|rebirth|ack|last|screen|status|watch|check|wait|finish|review|config|doctor|setup|version|help) "cmd_$sub" "$@" ;;
  *) die "unknown command '$sub' (see 'brig help')" ;;
esac
