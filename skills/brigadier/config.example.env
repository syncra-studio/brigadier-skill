# Brigadier settings. Copy to ~/.claude/brigadier/config.env and change what you need.
# A run can override any of these in <run>/config.env; environment variables win over both.
# `brig config` prints the effective values and where each one came from.

# Terminal backend: auto | cmux | tmux.
# auto = cmux inside cmux, tmux inside tmux, otherwise a detached tmux session in the background.
BRIG_BACKEND=auto
# tmux only: auto | background (force a separate detached session even when you're inside tmux).
BRIG_TMUX_MODE=auto

# Models. Aliases (opus, sonnet, haiku) or full model ids, whatever `claude --model` accepts.
BRIG_DEFAULT_MODEL=opus          # phase leads, verifiers, fix workers; also the reborn brigadier
BRIG_CHORE_MODEL=sonnet          # suggested for mechanical chores
BRIG_ALLOWED_MODELS="*"          # space-separated allowlist, e.g. "opus sonnet"; "*" allows any.
                                 # brig refuses other models, and workers' subagents are held to it too.

# Effort: low | medium | high | xhigh | max.
BRIG_DEFAULT_EFFORT=high
BRIG_MAX_EFFORT=high             # ceiling for Claude and Codex alike

# Crew size and handoff thresholds.
BRIG_MAX_WORKERS=3
BRIG_CTX_PCT=70                  # ask a worker to hand off at this context % ...
BRIG_CTX_TOKENS=300000           # ... or at this many context tokens, whichever comes first
BRIG_SELF_TOKENS=150000          # the brigadier's own context; past it, it hands the run to a fresh session

# Watchdog.
BRIG_STALL_MIN=30                # busy worker with no activity for this many minutes
BRIG_IDLE_SEC=120                # a quiet "busy" worker gets its screen checked after this many seconds
BRIG_RATE_PCT=95                 # 5-hour subscription window % that raises RATE_LIMIT
BRIG_POLL=15                     # seconds between checks in `brig wait`
BRIG_REBIRTH_TIMEOUT=900         # seconds the old brigadier waits for its successor's `brig ack`

# Codex (optional). auto = used when `codex` is on PATH; off = never.
BRIG_CODEX=auto
# Reviews: auto (Codex if available, else a read-only Claude session) | codex | claude | off.
BRIG_REVIEWER=auto

# Worker permissions: bypassPermissions | acceptEdits | auto | dontAsk | manual.
# bypassPermissions lets workers run unattended. Anything stricter means permission prompts
# reach the brigadier as NEEDS_INPUT events, and it approves only what its rules allow.
# Codex workers: bypassPermissions = no sandbox; anything else = workspace-write sandbox, no prompts.
BRIG_PERMISSION_MODE=bypassPermissions

# Run new workers under another logged-in Claude Code config dir (e.g. a second account).
BRIG_CLAUDE_CONFIG_DIR=
